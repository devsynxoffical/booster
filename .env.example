# Shopify Growth Booster - Environment Configuration

# Server Port
PORT=3005
NODE_ENV=production

# Public URL of your deployed server (e.g. https://booster-5imz.onrender.com)
PUBLIC_APP_URL=https://booster-5imz.onrender.com

# Shopify Store Credentials (Optional: can also be entered directly in the Booster UI)
SHOPIFY_SHOP_DOMAIN=your-brand.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: AI Provider for Deep SEO Blog Generation
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
